{
  "name": "course-schedule-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "课程表微信小程序 — 江南大学软件工程个人作业（Taro 4 + React 18 + TypeScript）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-platform-h5": "^4.3.0",
    "@tarojs/react": "^4.3.0",
    "@tarojs/router": "^4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.2",
    "typescript": "^5.6.3",
    "webpack": "5.91.0"
  }
}
